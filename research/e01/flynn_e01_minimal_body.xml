<?xml version="1.0"?>
<robot name="flynn_e01_minimal_body">
  <!-- Engineering test parameters only; no biological-accuracy claim. -->
  <link name="thorax">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>
  </link>
  <link name="left_upper_leg">
    <inertial><origin xyz="0 0 -0.15" rpy="0 0 0"/><mass value="0.15"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/></inertial>
  </link>
  <link name="left_lower_leg">
    <inertial><origin xyz="0 0 -0.15" rpy="0 0 0"/><mass value="0.10"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.00015"/></inertial>
  </link>
  <link name="left_foot">
    <inertial><origin xyz="0 0 -0.04" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/></inertial>
  </link>
  <link name="right_upper_leg">
    <inertial><origin xyz="0 0 -0.15" rpy="0 0 0"/><mass value="0.15"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0002"/></inertial>
  </link>
  <link name="right_lower_leg">
    <inertial><origin xyz="0 0 -0.15" rpy="0 0 0"/><mass value="0.10"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.00015"/></inertial>
  </link>
  <link name="right_foot">
    <inertial><origin xyz="0 0 -0.04" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="left_hip" type="revolute">
    <parent link="thorax"/><child link="left_upper_leg"/><origin xyz="0 0.12 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.8" upper="0.8" effort="2.0" velocity="4.0"/>
  </joint>
  <joint name="left_knee" type="revolute">
    <parent link="left_upper_leg"/><child link="left_lower_leg"/><origin xyz="0 0 -0.30" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.0" upper="1.0" effort="2.0" velocity="4.0"/>
  </joint>
  <joint name="left_ankle" type="fixed">
    <parent link="left_lower_leg"/><child link="left_foot"/><origin xyz="0 0 -0.30" rpy="0 0 0"/>
  </joint>
  <joint name="right_hip" type="revolute">
    <parent link="thorax"/><child link="right_upper_leg"/><origin xyz="0 -0.12 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.8" upper="0.8" effort="2.0" velocity="4.0"/>
  </joint>
  <joint name="right_knee" type="revolute">
    <parent link="right_upper_leg"/><child link="right_lower_leg"/><origin xyz="0 0 -0.30" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.0" upper="1.0" effort="2.0" velocity="4.0"/>
  </joint>
  <joint name="right_ankle" type="fixed">
    <parent link="right_lower_leg"/><child link="right_foot"/><origin xyz="0 0 -0.30" rpy="0 0 0"/>
  </joint>
</robot>
